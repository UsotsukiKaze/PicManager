# 应用配置
APP_NAME=图片编号管理系统
APP_VERSION=0.1.0
# 生产环境必须保持关闭；调试模式也不会绕过正常登录权限。
DEBUG=false

# 数据库配置（开发环境使用 SQLite）
DATABASE_URL=sqlite:///./data/picmanager.db
# 生产环境建议使用 PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/picmanager

# API 配置
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
ENABLE_API_DOCS=false

# 安全配置（生产环境必须修改）
# Set a unique 32+ character value in production. If this placeholder remains,
# PicManager creates a private persistent key in data/.secret_key at startup.
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
# API Key 认证（可选，留空则不需要认证）
API_KEY=
BOT_API_TOKEN=
PHROLOVA_SSO_TOKEN=
PHROLOVA_PUBLIC_BASE_URL=https://your-phrolova.example.com
PUBLIC_BASE_URL=http://127.0.0.1:8000
LOGIN_TICKET_TTL_SECONDS=300
ROOT_QQ=1356890337
# Comma-separated QQ IDs allowed to approve bot R18 requests; ROOT_QQ is always included.
AGE_RATING_SUPERUSERS=
AGE_RATING_ASSERTION_SECRET=
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
TRUSTED_HOSTS=localhost,127.0.0.1,pic.usotsuki-kaze.com,usotsuki-kaze.com,www.usotsuki-kaze.com
# Optional LAN-only HTTP debugging. Keep disabled in production. Hosts must be
# exact IP addresses/hostnames (wildcards are rejected), and the fixed base URL
# host must appear in LAN_DEBUG_HOSTS. LAN access still requires normal login;
# it never grants root. Open the selected port only to the local subnet.
LAN_DEBUG_ENABLED=false
LAN_DEBUG_HOSTS=
LAN_DEBUG_BASE_URL=
THUMBNAIL_SIZE=360

# 图片存储默认留在本地。切换为 r2 前先安装 boto3>=1.35 并填写全部 R2 配置。
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=images

# Cloudflare Tunnel / HTTPS 生产环境建议：
# PUBLIC_BASE_URL=https://pic.usotsuki-kaze.com
# CORS_ALLOW_ORIGINS=https://pic.usotsuki-kaze.com
# SESSION_COOKIE_SECURE=true
# ENABLE_API_DOCS=false
# 只有当你明确需要信任 Cloudflare Tunnel 传入的代理头时再开启。
# TRUST_PROXY_HEADERS=true

# CORS 配置（允许的域名，多个用逗号分隔）
ALLOWED_HOSTS=*

# 速率限制
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# 分页配置
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# 新图片会与所选角色的现有图片进行 64 位 dHash 比较。
# 0 仅匹配完全相同的哈希；建议保持在 2-6，数值过大会增加误判。
DUPLICATE_DHASH_DISTANCE=4
DUPLICATE_DECISION_TTL_SECONDS=600

# Pixiv 高清补全默认尝试匿名访问。如果 Pixiv 对所在网络要求登录，
# 可选填入浏览器请求中的 Cookie 字符串；请勿将真实 Cookie 提交到 Git。
PIXIV_COOKIE=
# 可选 HTTP/HTTPS 代理，Pixiv 作品 API 和 i.pximg.net 原图会统一使用。
# 代理必须能从运行 PicManager 的机器访问，例如 http://127.0.0.1:7890。
PIXIV_PROXY=
PIXIV_REQUEST_TIMEOUT_SECONDS=30
# 服务端连续检查两张图片之间的最小间隔，防止大量短连接耗尽套接字。
PIXIV_SCAN_INTERVAL_SECONDS=0.5
PIXIV_UPGRADE_DHASH_DISTANCE=10
PIXIV_UPGRADE_TOKEN_TTL_SECONDS=1800
PIXIV_MAX_DOWNLOAD_BYTES=104857600
