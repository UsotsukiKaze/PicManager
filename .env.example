# 应用配置
APP_NAME=图片编号管理系统
APP_VERSION=1.0.0
# 生产环境必须保持关闭；DEBUG 本身不会绕过登录权限。
DEBUG=false
# Localhost only: clicking guest login enters Root when both flags are true.
DEBUG_GUEST_ROOT=false

# 数据库配置（开发环境使用 SQLite）
DATABASE_URL=sqlite:///./data/picmanager.db
# 生产环境建议使用 PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/picmanager

# API 配置
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
ENABLE_API_DOCS=false

# 安全配置（生产环境必须修改）
# Set a unique 32+ character value in production. If this placeholder remains,
# PicManager creates a private persistent key in data/.secret_key at startup.
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
# API Key 认证（可选，留空则不需要认证）
API_KEY=
BOT_API_TOKEN=
PHROLOVA_SSO_TOKEN=
PHROLOVA_PUBLIC_BASE_URL=https://your-phrolova.example.com
PUBLIC_BASE_URL=http://127.0.0.1:8000
LOGIN_TICKET_TTL_SECONDS=300
ROOT_QQ=1356890337
# 与 KazeApps 使用同一随机令牌；该接口只允许服务器回环地址调用。
KAZE_APPS_INTERNAL_TOKEN=replace-with-the-same-random-token-used-by-kazeapps
# Comma-separated QQ IDs allowed to approve bot R18 requests; ROOT_QQ is always included.
AGE_RATING_SUPERUSERS=
AGE_RATING_ASSERTION_SECRET=
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
TRUSTED_HOSTS=localhost,127.0.0.1,pic.usotsuki-kaze.com
# Optional LAN-only HTTP debugging. Keep disabled in production. Hosts must be
# exact IP addresses/hostnames (wildcards are rejected), and the fixed base URL
# host must appear in LAN_DEBUG_HOSTS. LAN access still requires normal login;
# it never grants root. Open the selected port only to the local subnet.
LAN_DEBUG_ENABLED=false
LAN_DEBUG_HOSTS=
LAN_DEBUG_BASE_URL=
THUMBNAIL_SIZE=360
PREVIEW_SIZE=1600
PREVIEW_QUALITY=84

# 图片存储默认留在本地。切换为 r2 前先安装 boto3>=1.35 并填写全部 R2 配置。
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=images
# R2 需要允许站点域名执行 PUT，并允许 Content-Type 请求头。
# 建议给 images/incoming/ 配置 1 天生命周期规则，以清理中断上传产生的对象。
IMAGE_JOB_POLL_SECONDS=1.0
IMAGE_JOB_STALE_SECONDS=900

# Cloudflare Tunnel / HTTPS 生产环境建议：
# PUBLIC_BASE_URL=https://pic.usotsuki-kaze.com
# CORS_ALLOW_ORIGINS=https://pic.usotsuki-kaze.com
# SESSION_COOKIE_SECURE=true
# ENABLE_API_DOCS=false
# 只有当你明确需要信任 Cloudflare Tunnel 传入的代理头时再开启。
# TRUST_PROXY_HEADERS=true

# CORS 配置（允许的域名，多个用逗号分隔）
ALLOWED_HOSTS=*

# 速率限制
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# 分页配置
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# 新图片会与所选角色的现有图片进行 64 位 dHash 比较。
# 0 仅匹配完全相同的哈希；建议保持在 2-6，数值过大会增加误判。
DUPLICATE_DHASH_DISTANCE=4
DUPLICATE_DECISION_TTL_SECONDS=600

# Pixiv 高清补全默认尝试匿名访问。如果 Pixiv 对所在网络要求登录，
# 可选填入浏览器请求中的 Cookie 字符串；请勿将真实 Cookie 提交到 Git。
PIXIV_COOKIE=
# Pixiv-ol 账号由 Root 在页面绑定，不在环境变量中保存 Refresh Token。
# 可选 Fernet 加密密钥；留空时独立生成 data/.pixiv_ol_key，请与数据库分开备份。
PIXIV_OL_ENCRYPTION_KEY=
PIXIV_OL_SYNC_SECONDS=1800
PIXIV_OL_REQUEST_INTERVAL=1.0
# 未入库原图暂存总容量（默认 2 GiB），保存在 TEMP_PATH/pixiv-ol。
PIXIV_OL_CART_MAX_BYTES=2147483648
# 本机主登录使用 pixiv-cli 和系统默认浏览器；运行 python tools/install_pixiv_cli.py 安装固定版本。
# 留空时使用 DATA_PATH/pixiv-cli/pixiv.exe；可填写已安装的 pixiv-cli v1.1.1 完整路径。
PIXIV_CLI_EXECUTABLE=
# 仅旧版 automatic API 模式使用 Edge/Chromium；需 uv sync --extra browser。
PIXIV_OL_BROWSER_EXECUTABLE=
# 可选 HTTP/HTTPS 代理，Pixiv 作品 API 和 i.pximg.net 原图会统一使用。
# 代理必须能从运行 PicManager 的机器访问，例如 http://127.0.0.1:7890。
PIXIV_PROXY=
# Windows 中为空时沿用系统/环境 HTTP(S) 代理；false 禁用自动选择。
PIXIV_USE_SYSTEM_PROXY=true
PIXIV_REQUEST_TIMEOUT_SECONDS=30
# 图片 CDN 总并发预算（8..20）；默认列表 8 路，详情、头像、原图各保留 2 路。
PIXIV_MEDIA_DOWNLOAD_WORKERS=14
PIXIV_MEDIA_PREVIEW_WORKERS=8
# 服务端连续检查两张图片之间的最小间隔，防止大量短连接耗尽套接字。
PIXIV_SCAN_INTERVAL_SECONDS=0.5
# Pixiv 校验后台并发数（1 至 6）；待确认作品不占用线程，接口请求仍遵守全局限速。
PIXIV_CHECK_WORKERS=3
PIXIV_UPGRADE_DHASH_DISTANCE=10
PIXIV_UPGRADE_TOKEN_TTL_SECONDS=1800
PIXIV_MAX_DOWNLOAD_BYTES=104857600
# Pixiv 原图像素上限；默认 1 亿，最高 1 亿。与文件字节限制分别检查。
PIXIV_MAX_IMAGE_PIXELS=100000000
